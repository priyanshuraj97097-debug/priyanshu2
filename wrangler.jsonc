{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "priyanshu-2-0",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "main": "src/server.ts",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}